# PostgreSQL connection string used by Prisma.
# For local dev, spin up Postgres (e.g. `docker run --name helia-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres`)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helia?schema=public"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
APP_SECRET="change-me-to-a-long-random-string"

# Public base URL used to build patient-facing WhatsApp links (no trailing slash).
# Optional — falls back to the request host. Set on Vercel to your live domain.
APP_BASE_URL="https://your-domain.example"

# WhatsApp (Interakt) integration — https://app.interakt.ai/settings/developer-setting
# INTERAKT_API_KEY is the Basic-auth Secret Key from Interakt's Developer Settings.
# INTERAKT_TEMPLATE is the name of an APPROVED template with 3 body variables:
#   {{1}} patient first name, {{2}} document (e.g. "Chest X-Ray report"), {{3}} link.
INTERAKT_API_KEY=""
INTERAKT_TEMPLATE="helia_report_ready"
# Template language code as configured in Interakt (usually "en" or "en_US").
INTERAKT_TEMPLATE_LANG="en"
